filters:
  and:
    - type != "meta"
    - '!file.name.contains("Template")'
properties:
  note.type:
    displayName: Type
  note.status:
    displayName: Status
  note.scope:
    displayName: Scope
  file.mtime:
    displayName: Modified
  file.name:
    displayName: Note
views:
  - type: table
    name: Recently touched
    order:
      - file.name
      - type
      - status
      - scope
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: By type
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - status
      - scope
    sort:
      - property: file.name
        direction: ASC
