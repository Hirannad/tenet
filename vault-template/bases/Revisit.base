filters:
  and:
    - type == "decision"
    - '!file.name.contains("Template")'
    - "!revisit.isEmpty()"
    - status != "superseded"
    - status != "reversed"
    - status != "rejected"
properties:
  note.revisit:
    displayName: Revisit when
  note.status:
    displayName: Status
  note.scope:
    displayName: Scope
  note.created:
    displayName: Decided
  file.name:
    displayName: Decision
views:
  - type: table
    name: Oldest decisions first
    order:
      - file.name
      - revisit
      - created
      - scope
    sort:
      - property: created
        direction: ASC
  - type: table
    name: Universal only
    filters:
      and:
        - scope == "universal"
    order:
      - file.name
      - revisit
      - created
    sort:
      - property: created
        direction: ASC
